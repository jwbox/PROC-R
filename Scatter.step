version":2,"type":"code","flowMetadata":{"inputPorts":[{"name":"_inputTable","displayName":"_inputTable","localDisplayName":"_inputTable","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"}]},"ui":"{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"page1\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Page 1\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_inputTable\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"SAS Dataset\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"filter\": false\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_Xvar\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"X-Axis Variable\",\n\t\t\t\t\t\"include\": null,\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"a\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"_inputTable\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_Yvar\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Y-Axis Variable\",\n\t\t\t\t\t\"include\": null,\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"a\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"_inputTable\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_color\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Color Variable\",\n\t\t\t\t\t\"include\": null,\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"a\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"_inputTable\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_shape\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Shape Variable\",\n\t\t\t\t\t\"include\": null,\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"a\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"_inputTable\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"_Title\",\n\t\t\t\t\t\"type\": \"textarea\",\n\t\t\t\t\t\"label\": \"Enter a Title for the Graph\",\n\t\t\t\t\t\"placeholder\": \"Title Text Here\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"_inputTable\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"_Xvar\": [],\n\t\t\"_Yvar\": [],\n\t\t\"_color\": [],\n\t\t\"_shape\": [],\n\t\t\"_Title\": \"\"\n\t},\n\t\"promptHierarchies\": []\n}","localUi":"{\"pages\":[{\"children\":[{\"filter\":false,\"id\":\"_inputTable\",\"label\":\"SAS Dataset\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\",\"visible\":\"\"},{\"columntype\":\"a\",\"id\":\"_Xvar\",\"include\":null,\"label\":\"X-Axis Variable\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"_inputTable\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"a\",\"id\":\"_Yvar\",\"include\":null,\"label\":\"Y-Axis Variable\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"_inputTable\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"a\",\"id\":\"_color\",\"include\":null,\"label\":\"Color Variable\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"_inputTable\",\"type\":\"columnselector\",\"visible\":\"\"},{\"columntype\":\"a\",\"id\":\"_shape\",\"include\":null,\"label\":\"Shape Variable\",\"max\":1,\"min\":1,\"order\":false,\"table\":\"_inputTable\",\"type\":\"columnselector\",\"visible\":\"\"},{\"id\":\"_Title\",\"label\":\"Enter a Title for the Graph\",\"placeholder\":\"Title Text Here\",\"required\":true,\"type\":\"textarea\",\"visible\":\"\"}],\"id\":\"page1\",\"label\":\"Page 1\",\"type\":\"page\"}],\"promptHierarchies\":[],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"_Title\":\"\",\"_Xvar\":[],\"_Yvar\":[],\"_color\":[],\"_inputTable\":{\"library\":\"\",\"table\":\"\"},\"_shape\":[]}}","templates":{"SAS":"/* SAS templated code goes here */\r\n\r\n%let inputTable = &_inputTable;\r\n%let X = &_Xvar;\r\n%let Y = &_Yvar;\r\n%let Color = &_color;\r\n%let shape = &_shape;\r\n\r\n\r\n\r\nPROC R;\r\nsubmit;\r\n\r\nlibrary(ggplot2)\r\n# Read in Macro Variables\r\n# sym strips the quote envelopes\r\ndf= sd2df(symget(\"inputTable\"))\r\nplotX = sym(symget(\"X\"))\r\nplotY = sym(symget(\"Y\"))\r\nplotC = sym(symget(\"Color\"))\r\nplotS = sym(symget(\"shape\"))\r\ntitletxt = sym(symget(\"_Title\"))\r\n\r\n\r\n\r\n# Function to get either the label or the varaible name\r\nget_label <- function(df, varname) {\r\n  lbl <- attr(df[[varname]], \"label\")\r\n  if (is.null(lbl) || lbl == \"\") varname else lbl\r\n}\r\n\r\n\r\n\r\nplt = ggplot(df, aes(x=!!plotX, y = !!plotY, color = !!plotC, shape = !!plotS)) +\r\n  geom_point()+\r\n  labs (title = titletxt,\r\n        x = get_label(df, plotX),\r\n        y = get_label(df, plotY)\r\n        )\r\n\r\nrplot(plt)\r\n\r\nendsubmit;\r\nRUN;"}}
